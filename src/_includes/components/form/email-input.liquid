{% assign_local c = "c-email-input" %}
<div class="{{ c }}">
    <label class="{{ c }}__label" for="{{ id }}" data-editable="text" data-type="span" data-prop="label">{{ label }}{% if required %} *{% endif %}</label>
    <input class="{{ c }}__input"
        type="email" 
        id="{{ id }}" 
        name="_replyto" 
        placeholder="{{ placeholder }}"
        {% if required %}required{% endif %}
        onblur="validateInput(this)"
        oninput="validateInputTyping(this)"
        {% if helper_text %}aria-describedby="{{ id }}--helper"{% endif %}>

    {% if helper_text %}
        {% include "components/form/parts/helper-text", id: id, helper_text: helper_text %}
    {% endif %}

    {% include "components/form/parts/error-message", id: id %}
</div>