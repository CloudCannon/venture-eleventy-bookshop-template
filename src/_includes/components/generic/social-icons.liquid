<div class="c-social-icons"{% if links_prop %} data-editable="array" data-prop="{{ links_prop }}"{% endif %} style="
	{% if style.icon_background_hover_color %}
		--hover-color: {{ style.icon_background_hover_color }};
	{% else %}
		--hover-color: var(--main-text-color, #F9F9FB);
	{% endif %}

	{% if style.icon_color and style.icon_color != '' %}
		--fill-color: {{ style.icon_color }};
	{% else %}
		--fill-color: var(--main-text-color, #F9F9FB);
	{% endif %}

	{% if style.icon_hover_color %}
		--fill-color-hover: {{ style.icon_hover_color }};
	{% else %}
		--fill-color-hover: var(--main-background-color, #3B3B3D);
	{% endif %}
">
	{% comment %} links_prop lets data-file callers (nav, footer) bind the array. {% endcomment %}
	{% for item in social_media_links %}
		<a
			class="c-social-icons__icon"
			href="{{ item.link_url }}"
			target="_blank"
			rel="noopener noreferrer"
			aria-label="{{ item.label | default: 'social media link' }}"
			{% if links_prop %}data-editable="array-item" data-id="{{ forloop.index0 }}"{% endif %}
		>
			{% include "components/icons/custom-icon", icon_path: item.icon_path, icon_size: 'small', icon_type: 'solid', rounded_border: true, no_border: true, color: style.icon_color %}
		</a>
	{% endfor %}
</div>
