{%  assign_local c = 'c-simple-text-block' %}

<section {% if content.id %}id="{{ content.id }}"{% endif %} class='{{c}} component component--{{ styles.color_group }}'>
{% if content.heading or content.text %}
    <div class='{{c}}__content'>
        {% if content.heading %}
            <div data-editable="component" data-component="components/generic/heading/heading" data-prop="content.heading">
                {% includeWith "components/generic/heading/heading", content.heading %}
            </div>
        {% endif %}
        {% if content.text %}{% include "components/generic/text-block/text-block", text: content.text, prop: "content.text" %}{% endif %}
    </div>
{% endif %}
</section>
