{% comment %}
  Layout partial shared by the four left-right sections.

  It fails the one-data-path rule: each caller stores a different shape
  (left-right-contact has `contact_details`, left-right-testimonial has
  `quote`/`author_name`, ...), so its props can never be "the object at one data
  path" and it can't be a component editable region.

  Instead the *sections* render their own editable markup — they know the data
  paths — and pass it in as captured HTML. This partial owns layout and classes
  only. The enclosing section is a component region, so its captures regenerate
  on re-render.

  Slots: content_html (heading/text/icons block), buttons_html, media_html.
{% endcomment %}
{% assign_local c = "c-left-right-block" %}

{% capture social_icon_styles %}
  icon_background_hover_color: "var(--main-text-color)"
  icon_color: "var(--main-text-color)"
  icon_hover_color: "var(--main-background-color)"
{% endcapture %}
{% assign_local social_icons_style = social_icon_styles | ymlify %}

<div class="{{ c }} component {% if image_padding != true %}component--full-height{% endif %} {{ c }}--{{ image_alignment }}
  component--{{ color_group }}">

  <div class="{{ c }}__content">
    <div class="{{ c }}__content-wrapper">
      {% if display_social_icons %}
        {% include "components/generic/social-icons", social_media_links: site.social_media_links, style: social_icons_style %}
      {% endif %}
      {{ content_html }}
      {{ buttons_html }}
    </div>
  </div>
  <div class="{{ c }}__media {% if image_padding %}{{ c }}__media--auto-height{% endif %}">
    {{ media_html }}
  </div>
</div>
