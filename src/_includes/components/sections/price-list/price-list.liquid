{% assign_local c = "c-price-list" %}
<section {% if content.id %}id="{{ content.id }}"{% endif %} class="{{ c }} {{ c }}--content-align-{{ styles.content_alignment }} component component--{{ styles.color_group }}">

    {% if content.heading or content.description %}
        <div class="component__heading {{ c }}__heading">
            {% if content.heading %}
                <div data-editable="component" data-component="components/generic/heading/heading" data-prop="content.heading">
                    {% includeWith "components/generic/heading/heading", content.heading %}
                </div>
            {% endif %}
            {% if content.description %}{% include "components/generic/text-block/text-block", text: content.description, prop: "content.description" %}{% endif %}
        </div>
    {% endif %}

    <div class="{{ c }}__lists" data-editable="array" data-prop="content.lists">
        {% for list in content.lists %}
            <div class="{{ c }}__lists__list-group" data-editable="array-item" data-id="{{ forloop.index0 }}">
                <h4 class="{{ c }}__lists__list__heading" data-editable="text" data-type="span" data-prop="list_heading">{{ list.list_heading }}</h4>
                <ul class="{{ c }}__lists__list" data-editable="array" data-prop="list_items">
                    {% for item in list.list_items %}
                        <li class="{{ c }}__lists__list__item" data-editable="array-item" data-id="{{ forloop.index0 }}">
                            <p class="{{ c }}__lists__list__item__label" data-editable="text" data-type="span" data-prop="label">{{ item.label }}</p>
                            <span class="{{ c }}__lists__list__item__seperator"></span>
                            <p class="{{ c }}__lists__list__item__detail" data-editable="text" data-type="span" data-prop="detail">{{ item.detail }}</p>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        {% endfor %}
    </div>
    {% if content.button %}
        <div class="{{ c }}__button" data-editable="component" data-component="components/generic/button/button" data-prop="content.button">
            {% includeWith "components/generic/button/button", content.button %}
        </div>
    {% endif %}
</section>
