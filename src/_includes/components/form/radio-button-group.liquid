{% assign_local c = "c-radio-button-group" %}
<div class="{{ c }}">
    <fieldset class="{{ c }}__group" onClick="validateInputGroup(this)" {% if helper_text %}aria-describedby="{{ id }}--helper"{% endif %}>
        {% if label and label != '' %}
            <legend class="{{ c }}__group__label" data-editable="text" data-type="span" data-prop="label">{{ label }}{% if required %} *{% endif %}</legend>
        {% endif %}
        <div class="{{ c }}__group__inputs {{ c }}__group__inputs--arrangement-{{ arrangement }}" data-editable="array" data-prop="radio_buttons">
            {% assign_local group_name = label | append: "-" | append: id %}
            {% for item in radio_buttons %}
                {% comment %}
                  Was `id: radio_id`, which was never defined — every radio in a
                  group rendered id="" and the <label for> matched nothing.
                {% endcomment %}
                <div data-editable="array-item" data-id="{{ forloop.index0 }}">
                    {% include "components/form/parts/radio-input",
                         label: item.label,
                         checked: item.checked,
                         required: required,
                         group_name: group_name,
                         id: id | append: "-" | append: forloop.index0 %}
                </div>
            {% endfor %}
        </div>

    </fieldset>

    {% if helper_text %}
        {% include "components/form/parts/helper-text", id: id, helper_text: helper_text %}
    {% endif %}

    {% include "components/form/parts/error-message", id: id %}

</div>
