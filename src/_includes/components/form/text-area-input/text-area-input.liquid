{% assign_local c = "c-text-area-input" %}
<div class="{{ c }}">
    <label class="{{ c }}__label" for="{{ id }}" data-editable="text" data-type="span" data-prop="label">{{ label }}{% if required %} *{% endif %}</label>
    <textarea class="{{ c }}__input"
        id="{{ id }}" 
        name="{{ label }}" 
        placeholder="{{ placeholder }}"
        {% if required %}required{% endif %}
        rows="{{ rows }}"
        onblur="validateInput(this)"
        oninput="validateInputTyping(this)"
        {% if helper_text %}aria-describedby="{{ id }}--helper"{% endif %}></textarea>

    {% if helper_text %}
        {% include "components/form/parts/helper-text/helper-text", id: id, helper_text: helper_text %}
    {% endif %}

    {% include "components/form/parts/error-message/error-message", id: id %}

</div>