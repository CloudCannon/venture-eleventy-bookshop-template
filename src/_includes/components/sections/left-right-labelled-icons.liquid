{% comment %}
  The labelled-icon list used to be built as a YAML string (capture + ymlify)
  and passed to generic/labelled-icon. Synthetic objects have no data path, so
  nothing inside them could bind. The list is now rendered at its real paths as
  an array region; the icon itself stays sidebar-only (it's a select, and which
  icon component renders is derived from which field is set).
{% endcomment %}
{% assign_local c = "c-left-right-block--featured-icons" %}

{% capture content_html %}
  <div data-editable="component" data-component="components/generic/heading" data-prop="content.heading">
    {% includeWith "components/generic/heading", content.heading %}
  </div>
  {% if content.icons and content.icons.size > 0 %}
    <div class="c-left-right-block__icons" data-editable="array" data-prop="content.icons">
      {% for icon_data in content.icons %}
        <div class="c-labelled-icon c-labelled-icon--stacked" data-editable="array-item" data-id="{{ forloop.index0 }}">
          {% if icon_data.hero_library_icon_name %}
            {% include "components/icons/hero-library-icon",
                 hero_library_icon_name: icon_data.hero_library_icon_name,
                 icon_size: 'large', icon_type: icon_data.icon_type,
                 rounded_border: true, theme_color: true %}
          {% else %}
            {% include "components/icons/custom-icon",
                 icon_path: icon_data.icon_path,
                 icon_size: 'large', icon_type: icon_data.icon_type,
                 rounded_border: true, theme_color: true %}
          {% endif %}
          {% include "components/generic/text-block", text: icon_data.icon_text, prop: "icon_text" %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endcapture %}

{% capture buttons_html %}
  {% if content.buttons and content.buttons.size > 0 %}
    <div class="c-left-right-block__buttons" data-editable="array" data-prop="content.buttons">
      {% for button in content.buttons %}
        <div data-editable="array-item" data-component="components/generic/button" data-id="{{ forloop.index0 }}">
          {% includeWith "components/generic/button", button %}
        </div>
      {% endfor %}
    </div>
  {% endif %}
{% endcapture %}

{% capture media_html %}
  {% if content.image.image_path %}
    {% include "components/assets/image",
         image_path: content.image.image_path,
         image_alt: content.image.image_alt,
         image_sizes: content.image.image_sizes,
         prop_src: "content.image.image_path",
         prop_alt: "content.image.image_alt" %}
  {% endif %}
{% endcapture %}

<section {% if content.id %}id="{{ content.id }}"{% endif %} class="{{ c }}">
  {% include "components/layout/left-right-block",
       content_html: content_html,
       buttons_html: buttons_html,
       media_html: media_html,
       image_alignment: styles.image_alignment,
       color_group: styles.color_group %}
</section>
